OPENAI_API_KEY=your_openai_api_key_here

# Company inbox. Defaults to quantavexcorporation@gmail.com.
CONTACT_TO_EMAIL=quantavexcorporation@gmail.com

# Gmail app password — required for reliable contact delivery on Vercel.
# Google Account → Security → 2-Step Verification → App passwords.
SMTP_USER=quantavexcorporation@gmail.com
SMTP_PASS=

# Canonical public URL (custom domain). Used by sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://quantavex.vercel.app

# Live product URLs — leave blank until each platform is uploaded.
NEXT_PUBLIC_QUANTRION_URL=https://quantrion-ai.vercel.app
NEXT_PUBLIC_VDOC_URL=https://vdoc-ai.vercel.app
NEXT_PUBLIC_EXORAX_URL=
